{
  "name": "Transcribe Moment",
  "description": "When a moment is saved, transcribe its audio and store the transcript on the record so audio and text stay together",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Moment",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.status == \"pending\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "transcribe_moment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "transcribe": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "transcribeMoment",
            "args": {
              "momentId": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Transcribe moment",
            "description": "Transcribe audio and save transcript"
          }
        }
      }
    ]
  }
}