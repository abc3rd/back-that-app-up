{
  "name": "DriveUsage",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The app user this Google Drive quota counter belongs to"
    },
    "total_bytes": {
      "type": "number",
      "description": "Cumulative claimed bytes queued for Google Drive upload",
      "default": 0
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}