{
  "name": "Moment",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Short summary of the captured moment"
    },
    "name": {
      "type": "string",
      "description": "Filename of the captured clip"
    },
    "timestamp": {
      "type": "number",
      "description": "When the moment was captured, epoch ms"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "button",
        "voice",
        "spike"
      ],
      "description": "How the moment was captured"
    },
    "duration_ms": {
      "type": "number",
      "description": "Length of the clip in milliseconds"
    },
    "peak_db": {
      "type": "number",
      "description": "Peak audio level in dB"
    },
    "location_label": {
      "type": "string",
      "description": "Place name where captured"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags"
    },
    "audio_uri": {
      "type": "string",
      "description": "Private storage URI of the audio file"
    },
    "transcript": {
      "type": "string",
      "description": "Transcribed text of the audio"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "transcribing",
        "done",
        "failed"
      ],
      "description": "Transcription status"
    }
  },
  "required": [
    "audio_uri"
  ]
}